# Copy to .env for local scripts. In production, set these in Vercel → Project → Settings → Environment Variables.

# Shared secret. GoHighLevel sends it in the "x-webhook-secret" header. Use a long random string.
WEBHOOK_SECRET=replace-with-a-long-random-string

# The long ID in your sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Tab name inside the sheet (default: Leads)
SHEET_TAB=Leads

# The full service-account JSON key, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Slack Incoming Webhook URL for error alerts. Leave empty to log alerts instead.
SLACK_WEBHOOK_URL=
